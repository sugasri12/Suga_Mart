# SUGA'S MART Environment Configuration
# Copy this file to .env or configure these variables in your hosting provider (Render, Railway, etc.)

# Port assigned by cloud host (Render sets this automatically)
PORT=5000

# Option 1: Full Database URL (e.g. from TiDB Cloud, Railway, Aiven, Clever Cloud)
# DATABASE_URL=mysql://user:password@gateway.region.tidbcloud.com:4000/suga_mart?ssl=true

# Option 2: Individual Database Connection Variables
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=suga_mart
DB_PORT=3306
DB_SSL=false
